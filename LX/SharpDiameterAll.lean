import LX.EvenConjecture
import LX.OddConjecture
import LX.ConjectureLower

namespace LX

/-- A literal word in the two permitted letters represents every
permutation within the sharp parity-dependent bound. -/
theorem sharp_word_all (n : ℕ) [NeZero n] (hn : 5 ≤ n) (p : State n) :
    ∃ w : List Letter,eval w=p ∧
      4*(w.length : ℤ) ≤ 3*(n : ℤ)^2-8*n+12-3*((n%2 : ℕ) : ℤ) := by
  have he : n%2=0 ∨ n%2=1 := by omega
  rcases he with he | he
  · obtain ⟨w,hw,hprice⟩ := even_exists_word_conjecture (by omega) p (n/2) (by omega)
    exact ⟨w,hw,by simpa only [he,Nat.cast_zero,mul_zero,sub_zero] using hprice⟩
  · obtain ⟨w,hw,hprice⟩ := odd_exists_word_conjecture hn p (n/2) (by omega)
    refine ⟨w,hw,?_⟩
    rw [he,Nat.cast_one,mul_one]
    linarith

theorem sharp_diameter_all (n : ℕ) [NeZero n] (hn : 5 ≤ n) :
    (diameter n : ℚ) ≤ (3*(n : ℚ)^2-8*n+12-3*((n%2 : ℕ) : ℚ))/4 := by
  have he : n%2=0 ∨ n%2=1 := by omega
  rcases he with he | he
  · rw [he,Nat.cast_zero,mul_zero,sub_zero]
    exact even_diameter_conjecture_upper (by omega) (n/2) (by omega)
  · rw [he,Nat.cast_one,mul_one]
    have hh := odd_diameter_conjecture_upper hn (n/2) (by omega : n=2*(n/2)+1)
    convert hh using 1 <;> ring

/-- The word bound applies to every ordered pair of vertices. -/
theorem sharp_route_all (n : ℕ) [NeZero n] (hn : 5 ≤ n) (a b : State n) :
    ∃ w : List Letter,a*eval w=b ∧
      4*(w.length : ℤ) ≤ 3*(n : ℤ)^2-8*n+12-3*((n%2 : ℕ) : ℤ) := by
  obtain ⟨w,hw,hprice⟩ := sharp_word_all n hn (a⁻¹*b)
  exact ⟨w,by rw [hw]; simp,hprice⟩

theorem diameter_eq_max_dist (n : ℕ) [NeZero n] :
    diameter n=Finset.univ.sup (fun a : State n =>
      Finset.univ.sup (fun b : State n => dist a b)) := by
  apply le_antisymm
  · apply Finset.sup_le
    intro p _
    have hp := Finset.le_sup (f := fun b : State n => dist (1 : State n) b) (Finset.mem_univ p)
    have h1 := Finset.le_sup (f := fun a : State n => Finset.univ.sup (fun b : State n => dist a b))
      (Finset.mem_univ (1 : State n))
    simpa only [dist,inv_one,one_mul] using hp.trans h1
  · apply Finset.sup_le
    intro a _
    apply Finset.sup_le
    intro b _
    exact dist_le_diameter a b

/-- The exact directed Cayley diameter of S_n generated by L and X,
for all n > 4. The constants are 3 for even n and 9/4 for odd n. -/
theorem exact_diameter_all (n : ℕ) [NeZero n] (hn : 5 ≤ n) :
    (diameter n : ℚ)=(3*(n : ℚ)^2-8*n+12-3*((n%2 : ℕ) : ℚ))/4 :=
  le_antisymm (sharp_diameter_all n hn) (diameter_conjecture_lower n hn)

/-- The same equality without division or coercions to the rationals. -/
theorem exact_diameter_all_int (n : ℕ) [NeZero n] (hn : 5 ≤ n) :
    4*(diameter n : ℤ)=3*(n : ℤ)^2-8*n+12-3*((n%2 : ℕ) : ℤ) := by
  have he := exact_diameter_all n hn
  have hq : 4*(diameter n : ℚ)=3*(n : ℚ)^2-8*n+12-3*((n%2 : ℕ) : ℚ) := by linarith
  apply Int.cast_injective (α := ℚ)
  push_cast
  exact hq

