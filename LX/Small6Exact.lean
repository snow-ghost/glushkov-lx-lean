def score (p : State 6) : ℕ := potentials[LRX.codeIndex (LRX.encode p)]!

theorem potential_zero : score 1=0 := by decide +kernel

theorem potential_edges : ∀ c : LRX.PermCode 6,∀ a : Letter,
    score (LRX.decode c*eval [a]) ≤ score (LRX.decode c)+1 := by
  have checked : ∀ c : LRX.PermCode 6,
      score (LRX.decode c*eval [.l]) ≤ score (LRX.decode c)+1 ∧
      score (LRX.decode c*eval [.x]) ≤ score (LRX.decode c)+1 := by
    decide +kernel
  intro c a
  cases a with
  | l => exact (checked c).1
  | x => exact (checked c).2

noncomputable def farthest : State 6 :=
  Equiv.ofBijective ![2,0,5,4,3,1] (by decide +kernel)

theorem farthest_score : score farthest=18 := by decide +kernel

theorem diameter_lower : 18 ≤ diameter 6 := by
  have hb := lower_of_code_potential (by decide : 2 ≤ 6) score
    potential_zero potential_edges farthest
  simpa only [farthest_score] using hb

theorem exact_diameter : diameter 6=18 :=
  Nat.le_antisymm sharp_diameter diameter_lower

#print axioms diameter_lower
#print axioms exact_diameter
end LX.Small6
